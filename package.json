{
  "name": "interns-landings",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "rewrite:images": "node src/lib/rewriteAssetsBuild.mjs",
    "gen:markup": "node src/lib/gen-markup-index.mjs",
    "gen:scripts": "node src/lib/gen-scripts-index.mjs",
    "gen:styles": "node src/lib/gen-styles-index.mjs",
    "gen:markup:watch": "node src/lib/gen-markup-index.mjs --watch",
    "gen:scripts:watch": "node src/lib/gen-scripts-index.mjs --watch",
    "gen:styles:watch": "node src/lib/gen-styles-index.mjs --watch",
    "gen:all": "npm run gen:markup && npm run gen:scripts && npm run gen:styles",
    "dev": "npm run gen:all && concurrently -n MARKUP,SCRIPTS,STYLES,VITE -c auto \"npm:gen:markup:watch\" \"npm:gen:scripts:watch\" \"npm:gen:styles:watch\" \"vite\"",
    "check": "node src/lib/check-assets-prefix.mjs",
    "typograf": "node src/lib/typograf-html.mjs",
    "block:add": "node src/lib/block-add.mjs",
    "block:rename": "node src/lib/block-rename.mjs",
    "build": "npm run check && node src/lib/build-cms.mjs && node src/lib/rewriteAssetsBuild.mjs",
    "test:serve": "node src/lib/build-cms.mjs && node tests/serve.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "b2c-landing-vite deploy",
    "deploy:section": "b2c-landing-vite deploy --section",
    "deploy:assets": "b2c-landing-vite deploy assets"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^4.1.10",
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "posthtml": "^0.16.7",
    "posthtml-include": "^2.0.1",
    "sass": "^1.102.0",
    "typograf": "^7.7.0",
    "vite": "^8.2.1",
    "vite-plugin-monkey": "^8.1.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "embla-carousel": "^8.6.0",
    "express": "^5.2.1",
    "flatpickr": "^4.6.13",
    "gsap": "^3.15.0",
    "rxjs": "^7.8.2",
    "selector-observer": "^2.1.6",
    "zod": "^4.4.3"
  }
}
